# NeoCoin Configuration
# Copy this to .env and fill in your values

# REQUIRED: Admin token for protected endpoints (generate a strong random string)
ADMIN_TOKEN=your-secure-admin-token-here

# OPTIONAL: Miner address (if mining)
MINER_ADDRESS=

# OPTIONAL: Enable auto mining
AUTO_MINE=false

# OPTIONAL: AI Auditor URL (for policy checking)
# AI_AUDITOR_URL=http://ai-auditor:8000

# OPTIONAL: Chain ID (1=mainnet, 2=testnet)
CHAIN_ID=1

# OPTIONAL: Rate limiting (requests per second)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=20
