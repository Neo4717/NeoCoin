# NeoCoin Environment Configuration
# Copy this to .env and customize

# REQUIRED: Admin token for protected endpoints
# Generate a strong random string like: head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 16
# Or leave blank - the start script will generate one automatically
ADMIN_TOKEN=

# Mining (optional - auto-enabled if MINER_ADDRESS set)
# Get your miner address by running: ./neocoin create_wallet
# MINER_ADDRESS=NEO00...

# Network peer addresses (optional)
# P2P_PEERS=onion-address.onion:9090
# PEERS=http://peer:8080

# Chain Configuration
CHAIN_ID=3
GENESIS_PATH=../genesis/smoke.json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=20

# Ports
# HTTP_ADDR=127.0.0.1:8080
# P2P_LISTEN_ADDR=0.0.0.0:9090